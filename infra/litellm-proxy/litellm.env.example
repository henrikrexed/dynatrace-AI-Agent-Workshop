# LiteLLM proxy + dispenser secret file — TEMPLATE ONLY.
#
# Copy this to /etc/litellm/litellm.env ON THE LXC HOST, fill in the real
# values, and lock it down (chmod 600, root:root). It is loaded by both
# systemd units via EnvironmentFile=. NEVER commit the filled-in version.
#
#   sudo install -d -m 750 /etc/litellm
#   sudo cp litellm.env.example /etc/litellm/litellm.env
#   sudo chmod 600 /etc/litellm/litellm.env
#   sudo chown root:root /etc/litellm/litellm.env
#   sudo "$EDITOR" /etc/litellm/litellm.env   # fill in the three REAL values

# ── Upstream DeepSeek account key (HUMAN-GATED — Henrik injects this) ─────────
# This is the ONE credential that carries real credit. The ~$240 session
# ceiling (60 users x $4) must exist on this account.
DEEPSEEK_API_KEY=sk-REPLACE-WITH-REAL-DEEPSEEK-KEY

# ── LiteLLM admin master key (generate a long random value) ───────────────────
# Used only by the dispenser to mint/revoke virtual keys. Rotate freely.
#   openssl rand -hex 32   # -> paste as sk-<hex>
LITELLM_MASTER_KEY=sk-REPLACE-WITH-RANDOM-MASTER-KEY

# ── Room password attendees present to the dispenser (rotated per session) ────
#   openssl rand -base64 12
WORKSHOP_ROOM_PASSWORD=REPLACE-WITH-ROOM-PASSWORD

# ── Public URL the dispenser hands back to attendees (Tailscale Funnel host) ──
# No secret, but kept out of git so the repo pins no environment-specific URL.
PROXY_PUBLIC_URL=https://REPLACE-WITH-FUNNEL-HOST.ts.net

# ── Per-attendee budget cap (USD) and window ──────────────────────────────────
VIRTUAL_KEY_MAX_BUDGET=4
VIRTUAL_KEY_BUDGET_DURATION=30d

# ── Virtual-key / budget database (local PostgreSQL) ──────────────────────────
# LiteLLM's key/budget store REQUIRES PostgreSQL (it rejects sqlite:// at boot).
# scripts/setup-postgres.sh provisions a local role+db on the LXC; paste the
# password it generates here.
DATABASE_URL=postgresql://litellm:REPLACE-WITH-DB-PASSWORD@127.0.0.1:5432/litellm
