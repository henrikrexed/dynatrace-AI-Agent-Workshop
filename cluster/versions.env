# Pinned chart/image versions for the Phase 2 platform install.
# Sourced by install.sh. Bump here to upgrade the whole stack in one place.

# Helm chart versions (classic repos registered in .devcontainer/bootstrap/prep-stack.sh).
DT_OPERATOR_CHART_VERSION="1.11.1"          # dynatrace/dynatrace-operator
OTEL_OPERATOR_CHART_VERSION="0.126.2"       # open-telemetry/opentelemetry-operator (app 0.161.0)
TETRAGON_CHART_VERSION="1.7.1"              # cilium/tetragon

# kagent moved to OCI Helm charts (the classic github.io repo now 404s).
KAGENT_CHART_VERSION="0.10.4"
KAGENT_OCI_REPO="oci://ghcr.io/kagent-dev/kagent/helm"

# Container images pinned by manifests.
PHOENIX_IMAGE="arizephoenix/phoenix:version-20.19.0-nonroot"  # UI 6006 + OTLP gRPC 4317

# kubernetes-sigs/agent-sandbox (recommended default).
AGENT_SANDBOX_REF="main"   # git ref of kubernetes-sigs/agent-sandbox install manifests

# --- Phase 3: agents & MCP wiring (ISI-6716) --------------------------------
# MCP tool-server images/packages referenced by agents/mcp/*. Bump here to roll
# the whole crew's tooling. github-mcp-server runs as a kagent-managed MCPServer
# (stdio); the Dynatrace MCP npm package runs via npx inside a Node base image.
GITHUB_MCP_IMAGE="ghcr.io/github/github-mcp-server:v2.0.3"
DYNATRACE_MCP_NODE_IMAGE="node:22-slim"              # base image that runs npx
DYNATRACE_MCP_PACKAGE="@dynatrace-oss/dynatrace-mcp-server@2.1.2"
# Shared agent LLM. DeepSeek by default (ISI-6716 — cost-efficient; OpenAI-API
# compatible, reads secret/kagent-deepseek). Change the model here to retune the
# whole crew; swap provider/baseUrl in agents/mcp/00-modelconfig.yaml + cluster/kagent/values.yaml.
WORKSHOP_LLM_MODEL="deepseek-chat"
WORKSHOP_LLM_BASE_URL="https://api.deepseek.com/v1"   # DeepSeek OpenAI-compatible endpoint


# --- Diagnostic module: opentelemetry-demo-light (ISI-6847 / scenario #12) ---
# Opt-in app dependency for the fault-injection diagnostic module's scenario #12
# (app-level intermittent-5xx correlation). Deployed ONLY when INSTALL_OTEL_DEMO=true
# (default false) so the base workshop and scenarios 01-03 fit the 4-core/16GB
# Codespace floor. The light fork (henrikrexed/opentelemetry-demo-light) trims the
# upstream OTel Demo to frontend/product-catalog/cart/checkout/payment (+postgres,
# valkey, loadgen) and publishes its OWN OCI Helm chart (not a values overlay).
OTEL_DEMO_CHART_VERSION="0.2.8"
OTEL_DEMO_OCI_REPO="oci://ghcr.io/henrikrexed/charts/opentelemetry-demo-light"

# --- Phase 4: evaluations (ISI-6719/6717) -----------------------------------
# dt-evals CLI (npm, run via npx). Pinned so the workshop stays reproducible —
# the runner (evals/dt-evals/run-dt-eval.sh) reads this; without it, it silently
# falls back to @alpha. Bump deliberately: dt-evals is pre-1.0 and its config
# schema can move. Phoenix eval tooling is pinned in evals/pyproject.toml.
DT_EVALS_PKG="@dynatrace-oss/dt-evals@0.3.4-alpha"    # schemaVersion 3; Node >=22
