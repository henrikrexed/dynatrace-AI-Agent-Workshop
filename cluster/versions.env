# Pinned chart/image versions for the Phase 2 platform install.
# Sourced by install.sh. Bump here to upgrade the whole stack in one place.

# Helm chart versions (classic repos registered in .devcontainer/bootstrap/prep-stack.sh).
DT_OPERATOR_CHART_VERSION="1.11.1"          # dynatrace/dynatrace-operator
OTEL_OPERATOR_CHART_VERSION="0.126.2"       # open-telemetry/opentelemetry-operator (app 0.161.0)
TETRAGON_CHART_VERSION="1.7.1"              # cilium/tetragon

# kagent moved to OCI Helm charts (the classic github.io repo now 404s).
KAGENT_CHART_VERSION="0.10.4"
KAGENT_OCI_REPO="oci://ghcr.io/kagent-dev/kagent/helm"

# Container images pinned by manifests.
PHOENIX_IMAGE="arizephoenix/phoenix:version-20.19.0-nonroot"  # UI 6006 + OTLP gRPC 4317

# kubernetes-sigs/agent-sandbox (recommended default).
AGENT_SANDBOX_REF="main"   # git ref of kubernetes-sigs/agent-sandbox install manifests

# --- Phase 3: agents & MCP wiring (ISI-6716) --------------------------------
# MCP tool-server images/packages referenced by agents/mcp/*. Bump here to roll
# the whole crew's tooling. github-mcp-server runs as a kagent-managed MCPServer
# (stdio); the Dynatrace MCP npm package runs via npx inside a Node base image.
GITHUB_MCP_IMAGE="ghcr.io/github/github-mcp-server:v2.0.3"
DYNATRACE_MCP_NODE_IMAGE="node:22-slim"              # base image that runs npx
DYNATRACE_MCP_PACKAGE="@dynatrace-oss/dynatrace-mcp-server@2.1.2"
# Shared agent LLM (OpenAI by default — reads secret/kagent-openai). Change the
# model here to retune the whole crew; swap provider in agents/mcp/00-modelconfig.yaml.
WORKSHOP_LLM_MODEL="gpt-4.1-mini"
