# Kubernetes / local cluster
.kube/
kubeconfig*
*.kubeconfig

# Attendee-rendered Dynatrace assets (envsubst output of ${WORKSHOP_PREFIX}, ISI-6986)
.rendered/

# Attendee-personalized workshop docs served in-cluster by the mkdocs pod
# (envsubst output of render-docs.sh: DQL + launchpad scoped to ${WORKSHOP_PREFIX}
# / ${DT_TENANT_URL}, ISI-7007). Regenerated every boot — never committed.
.workshop-site/

# Secrets — never commit (contract: .devcontainer/SECRETS.md)
.env
.env.*
# ...but example templates ARE committed (placeholders only, no secrets):
!.env.example
*.secret
*-token
*.pem
# Dispensed per-attendee model-proxy endpoint + minted virtual key (ISI-6996);
# written by .devcontainer/bootstrap/dispense-llm.sh from WORKSHOP_ROOM_PASSWORD.
.workshop-llm.env

# Python / uv / dt-evals
.venv/
__pycache__/
*.pyc
.uv/
.ruff_cache/
.pytest_cache/

# Rendered dt-evals configs contain secrets (token/judge key) — never commit.
evals/dt-evals/*.generated.yaml
evals/dt-evals/*.generated.dt-eval.yaml
# Eval run artifacts (scores/CSVs).
evals/phoenix/out/

# MkDocs build output
site/

# Editor / OS
.DS_Store
*.swp
