# Copy to evals/.env and fill in. evals/.env is gitignored — never commit secrets.
# Both eval paths read from here.

# --- Judge LLM (shared by Phoenix + dt-evals) --------------------------------
# A DeepSeek key works for both: DeepSeek's API is OpenAI-compatible, so the
# judge uses the OpenAI provider with the base URL pointed at DeepSeek.
OPENAI_API_KEY=sk-your-deepseek-or-openai-key
# Phoenix path reads this; keep in sync with the agents' model.
JUDGE_MODEL=deepseek-chat
# Drop / comment this line to judge with real OpenAI instead of DeepSeek.
OPENAI_BASE_URL=https://api.deepseek.com/v1

# --- dt-evals path only ------------------------------------------------------
# Dedicated dt-evals token (dt0c01) with scopes: storage:spans:read + storage:events:write.
# NOT the Phase-2 OTLP ingest token.
DYNATRACE_API_TOKEN=dt0c01.your-dt-evals-token
# Platform apps URL. If unset, run-dt-eval.sh derives it from DT_TENANT_URL.
DT_ENVIRONMENT_URL=https://abc12345.apps.dynatrace.com
# service.name of the agent to evaluate — DISCOVER it (see dt-evals/README.md).
DT_EVAL_SERVICE=

# --- Phoenix path only -------------------------------------------------------
# Only needed for `--from-phoenix` (defaults shown).
PHOENIX_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT=default
