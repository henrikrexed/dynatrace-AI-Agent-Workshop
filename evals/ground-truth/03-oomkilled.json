{
  "scenario": "03-oomkilled",
  "title": "OOMKilled",
  "fault_family": "infra",
  "namespace": "workshop-faults",
  "requires": ["cluster-state"],
  "pass_threshold": 3,
  "ground_truth_md": "scenarios/03-oomkilled/expected-diagnosis.md",
  "reference_answer": "The image-resizer container tries to allocate far more memory (~250Mi) than its 32Mi memory limit allows, so the kernel OOM-killer terminates it (exit 137) and it restarts into a back-off loop.",
  "required_signals": [
    {"id": "oom-reason", "desc": "lastState.terminated.reason: OOMKilled", "any_of": ["oomkilled", "oom-killed", "oom killer", "oom-killer", "out-of-memory kill", "out of memory kill"]},
    {"id": "exit-137", "desc": "lastState.terminated.exitCode: 137 (128 + SIGKILL)", "any_of": ["137", "sigkill", "signal 9"]},
    {"id": "limit-too-low", "desc": "memory limit (32Mi) too low for the workload", "any_of": ["32mi", "memory limit", "limit is too low", "exceeds its memory", "exceeds the memory", "250mi", "more than its", "over its limit", "memory it allocates"]},
    {"id": "restart-oom-loop", "desc": "pod restarting / CrashLoopBackOff driven by repeated OOM kills", "any_of": ["restart", "crashloopbackoff", "back-off", "backoff", "restart count"]}
  ],
  "root_cause_any_of": ["oom", "memory", "out of memory", "out-of-memory", "exceeds", "memory limit", "killed"],
  "must_not_claim": [
    {"id": "wrong-family-appcrash", "desc": "a plain application crash / app exit code 1 with no OOM (scenario 01)", "any_of": ["exit code 1", "exit 1", "application crash", "config error", "billing_db_url", "config load failed"]},
    {"id": "wrong-family-imagepull", "desc": "image-pull / registry failure (scenario 02)", "any_of": ["imagepullbackoff", "errimagepull", "image pull", "pull the image", "image tag", "registry"]},
    {"id": "wrong-probe-rootcause", "desc": "a liveness/readiness probe failure as the root cause", "any_of": ["liveness probe", "readiness probe", "probe failed", "probe failure"]},
    {"id": "wrong-node-eviction", "desc": "a node-pressure eviction (this is a per-container cgroup OOM, not an eviction)", "any_of": ["node pressure", "node-pressure", "eviction", "evicted", "disk pressure"]}
  ]
}
